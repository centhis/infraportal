# ==========================================
# Глобальные переменные окружения
# ==========================================

# --- База данных (PostgreSQL) ---
# Имя пользователя БД
POSTGRES_USER=myuser
# Пароль пользователя БД
POSTGRES_PASSWORD=mypassword
# Имя базы данных
POSTGRES_DB=infraportal
# Хост БД (в Docker Compose это имя сервиса 'db')
POSTGRES_HOST=db
# Порт БД
POSTGRES_PORT=5432

# --- Redis (Общие настройки) ---
# Хост Redis (в Docker Compose это имя сервиса 'redis')
REDIS_HOST=redis
# Порт Redis
REDIS_PORT=6379
# Пароль Redis
REDIS_PASSWORD=change_this_password

# --- Строки подключения Redis ---
# Основной URL (Брокер) - использует базу 0
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# URL для результатов (Result Backend) - использует базу 1
REDIS_RESULT_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/1

# --- Настройки Бэкенда (Общие) ---
# Режим отладки (True/False)
DEBUG=True
# Секретный ключ для шифрования (ОБЯЗАТЕЛЬНО ИЗМЕНИТЬ В ПРОДАКШЕНЕ!)
SECRET_KEY=change_this_secret_key_in_production
# Префикс API
API_PREFIX=/api/v1
# Разрешенные источники (CORS)
ALLOWED_ORIGINS=http://localhost:3000,http://frontend:3000
# Дефолтный администратор (создается при первом запуске)
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=admin

# --- Настройки Celery (Worker / Beat) ---
# Часовой пояс Celery
CELERY_TIMEZONE=UTC
# Использовать UTC
CELERY_ENABLE_UTC=True
# Таймаут задач (в секундах)
TASK_TIMEOUT=300
# API ключ для взаимодействия воркера с бэкендом (должен совпадать на обоих)
CELERY_WORKER_API_KEY=your_celery_worker_api_key
# Внутренний URL бэкенда для воркеров (внутри Docker сети)
BACKEND_INTERNAL_API_URL=http://backend:8000/api/internal

# --- Мониторинг (Flower) ---
# URL Flower для отображения в других сервисах (если нужно)
FLOWER_API_URL=http://flower-service:5555

# --- Фронтенд (Vite) ---
# URL API для фронтенда (проксируется через Nginx или напрямую)
VITE_API_URL=/api/v1
# Таймаут отображения алертов (мс)
VITE_ALERT_TIMEOUT=3000

# --- Настройки LDAP (Интеграция) ---
# Включить LDAP аутентификацию (True/False)
LDAP_ENABLED=False
# URI сервера LDAP
LDAP_URI=ldap://localhost:389
# Базовый DN для поиска
LDAP_BASE_DN=dc=example,dc=com
# Пользователь для чтения LDAP (Bind DN)
LDAP_BIND_DN=cn=admin,dc=example,dc=com
# Пароль пользователя LDAP
LDAP_BIND_PASSWORD=admin_password
# Фильтр для поиска пользователей
LDAP_USER_FILTER=(objectClass=person)
# Расписание синхронизации (Cron format)
LDAP_SYNC_SCHEDULE="0 0 * * *"
# Проверять TLS-сертификат LDAP (True/False)
LDAP_TLS_VERIFY=True
