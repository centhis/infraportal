# celery_worker/.env.example

# Celery Broker and Backend URLs (Redis)
# REDIS_TASK_URL: URL for the Redis instance used as the Celery broker (task queue).
# Default: redis://redis:6379/0
REDIS_TASK_URL="redis://redis:6379/0"

# REDIS_RESULT_URL: URL for the Redis instance used to store task results.
# Default: redis://redis:6379/1
REDIS_RESULT_URL="redis://redis:6379/1"

# Celery Timezone
# Default: Europe/Moscow
CELERY_TIMEZONE="Europe/Moscow"

# Whether to enable UTC for Celery
# Default: True
CELERY_ENABLE_UTC=True

# Backend Internal API URL
# This is the URL for the FastAPI backend's internal API, which the Celery worker
# will use to fetch secrets and task execution details.
# Example: http://backend-service:8000/internal/v1 (if running in Docker Compose)
BACKEND_INTERNAL_API_URL="http://localhost:8000/internal/v1"

# Celery Worker API Key
# This key is used by the Celery worker to authenticate itself with the backend's
# internal API when requesting secrets or task execution details.
CELERY_WORKER_API_KEY="your_celery_worker_api_key"

# Celery Accept Content (List of accepted content types for messages)
# Default: json
# CELERY_ACCEPT_CONTENT='["json"]'

# Celery Task Serializer
# Default: json
# CELERY_TASK_SERIALIZER="json"

# Celery Result Serializer
# Default: json
# CELERY_RESULT_SERIALIZER="json"
