# Базовые настройки
DATABASE_URL=postgresql://user:password@localhost:5432/infraportal
DEBUG=True
SECRET_KEY=generate_a_secure_random_key_here
ALLOWED_ORIGINS=http://localhost:3000

# LDAP Настройки (Используются для начального наполнения БД)
LDAP_ENABLED=False
LDAP_URI=ldap://localhost:389
LDAP_BASE_DN=dc=example,dc=com
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=admin_password
LDAP_USER_FILTER=(memberOf=cn=groups,...)
LDAP_SYNC_SCHEDULE=0 0 * * *
